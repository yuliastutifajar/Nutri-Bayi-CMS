---
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Tentang NutriBayi' },
];

const teamMembers = [
  {
    name: 'dr. Sarah Amanda, Sp.A',
    role: 'Dokter Spesialis Anak & Konsultan Nutrisi',
    avatar: 'https://images.unsplash.com/photo-1559839734-2b71ea197ec2?auto=format&fit=crop&w=400&q=80',
    bio: 'Berpengalaman 12+ tahun mendampingi ribuan ibu muda dalam manajemen tumbuh kembang anak, pemantauan kurva WHO, dan penanganan GTM.',
  },
  {
    name: 'Nadia Safira, S.Gz',
    role: 'Head of Pediatric Nutrition',
    avatar: 'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?auto=format&fit=crop&w=400&q=80',
    bio: 'Ahli gizi anak lulusan Universitas Indonesia yang merancang takaran makronutrien dan mikronutrien (zat besi, zink, kalsium) pada setiap menu.',
  },
  {
    name: 'Chef Maya Pratiwi',
    role: 'Executive Baby Food Chef',
    avatar: 'https://images.unsplash.com/photo-1580489944761-15a19d654956?auto=format&fit=crop&w=400&q=80',
    bio: 'Ibu dari 2 balita yang ahli menciptakan variasi rasa alami dari rempah aromatik segar tanpa tambahan garam, gula, dan penyedap rasa buatan.',
  },
];

const standards = [
  {
    icon: '🌱',
    title: '100% Bahan Alami Terpilih',
    desc: 'Kami bermitra dengan petani lokal bersertifikasi organik untuk menjamin sayuran dan beras bebas dari pestisida sintetis.',
  },
  {
    icon: '🥩',
    title: 'Protein Hewani Grade A',
    desc: 'Daging sapi tanpa lemak, ayam kampung segar, dan ikan kaya omega-3 dipilih ketat demi pasokan zat besi maksimal pencegah anemia.',
  },
  {
    icon: '🔬',
    title: 'Dapur Higienis Berstandar Lab',
    desc: 'Sterilisasi uap bersuhu tinggi dan kemasan bebas BPA (BPA-free) memastikan setiap porsi aman dari kontaminasi bakteri.',
  },
  {
    icon: '🥣',
    title: 'Gradasi Tekstur Presisi',
    desc: 'Setiap tekstur—dari puree halus, lumat berbulir, hingga finger food—dikalibrasi sesuai kemampuan oromotor oral bayi.',
  },
];
---

<Layout
  title="Tentang NutriBayi - Sahabat Nutrisi & MPASI Sehat Bayi Anda"
  description="Mengenal visi, misi, dan tim ahli di balik NutriBayi. Media digital dan penyedia produk MPASI sehat, praktis, bergizi, dan aman untuk si kecil."
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 pb-16">
    
    <!-- Breadcrumbs -->
    <Breadcrumbs items={breadcrumbItems} />

    <!-- Hero Tentang Kami -->
    <div class="mt-8 mb-16 text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-4 py-1.5 rounded-full bg-brand-orange-50 border border-brand-orange-200 text-brand-orange text-xs font-bold uppercase tracking-wider">
        Tentang NutriBayi
      </span>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-blue leading-tight">
        Menemani Ibu Menghadirkan Makanan Pertama yang Penuh Cinta
      </h1>
      <p class="text-slate-600 text-base sm:text-lg md:text-xl leading-relaxed">
        NutriBayi lahir dari kepedulian mendalam terhadap tantangan ibu muda di Indonesia saat memasuki masa MPASI: mulai dari ketakutan anak stunting, kebingungan tekstur, hingga lelahnya menghadapi Gerakan Tutup Mulut (GTM).
      </p>
    </div>

    <!-- Misi & Visi Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
      <div class="bg-gradient-to-br from-brand-orange-50/70 to-white rounded-3xl p-8 sm:p-10 border border-brand-orange-100 shadow-sm space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-brand-orange text-white flex items-center justify-center font-bold text-xl shadow-soft-orange">
          🎯
        </div>
        <h2 class="font-bubblegum text-3xl font-bold text-brand-orange">
          Misi Utama Kami
        </h2>
        <p class="text-slate-600 leading-relaxed text-base sm:text-lg">
          Menyediakan produk MPASI yang praktis namun tetap 100% sehat dan bernutrisi tinggi, sekaligus mengedukasi ibu muda dengan panduan ilmiah yang mudah dipahami demi tercapainya 1000 Hari Pertama Kehidupan yang gemilang.
        </p>
      </div>

      <div class="bg-gradient-to-br from-brand-blue-50/70 to-white rounded-3xl p-8 sm:p-10 border border-brand-blue-100 shadow-sm space-y-4">
        <div class="w-12 h-12 rounded-2xl bg-brand-blue text-white flex items-center justify-center font-bold text-xl shadow-soft-blue">
          🌟
        </div>
        <h2 class="font-bubblegum text-3xl font-bold text-brand-blue">
          Visi Jangka Panjang
        </h2>
        <p class="text-slate-600 leading-relaxed text-base sm:text-lg">
          Menjadi media digital dan brand MPASI nomor 1 pilihan keluarga muda di Indonesia, menciptakan generasi anak yang sehat, cerdas, aktif, dan bebas stunting di masa depan.
        </p>
      </div>
    </div>

    <!-- Standar Kualitas -->
    <div class="bg-slate-50 rounded-3xl p-8 sm:p-12 mb-20 border border-slate-100">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-2">
        <span class="text-brand-green font-bold text-xs uppercase tracking-wider">Tanpa Kompromi</span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-blue">
          4 Standar Keamanan Produk Kami
        </h2>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
        {standards.map((std) => (
          <div class="bg-white rounded-2xl p-6 border border-slate-200/60 shadow-sm hover:shadow-md transition">
            <div class="text-3xl mb-4">{std.icon}</div>
            <h3 class="font-bubblegum text-xl font-bold text-brand-blue mb-2">{std.title}</h3>
            <p class="text-slate-600 text-xs sm:text-sm leading-relaxed">{std.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Tim Ahli & Dokter -->
    <div class="mb-20">
      <div class="text-center max-w-2xl mx-auto mb-12 space-y-3">
        <span class="inline-block px-4 py-1.5 rounded-full bg-brand-blue-50 border border-brand-blue-200 text-brand-blue text-xs font-bold uppercase tracking-wider">
          Dedikasi & Kepakaran
        </span>
        <h2 class="text-3xl sm:text-4xl font-extrabold text-brand-blue">
          Tim Ahli di Balik NutriBayi
        </h2>
        <p class="text-slate-600">
          Setiap resep dan konten edukasi divalidasi langsung oleh praktisi kesehatan anak berlisensi.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {teamMembers.map((member) => (
          <div class="bg-white rounded-3xl p-6 sm:p-8 border border-slate-100 shadow-sm hover:shadow-xl transition-all duration-300 text-center flex flex-col items-center">
            <img
              src={member.avatar}
              alt={member.name}
              class="w-24 h-24 sm:w-28 sm:h-28 rounded-full object-cover border-4 border-orange-100 shadow-md mb-4"
              loading="lazy"
              width="112"
              height="112"
            />
            <h3 class="font-bubblegum text-xl sm:text-2xl font-bold text-brand-blue mb-1">
              {member.name}
            </h3>
            <span class="inline-block px-3 py-1 rounded-full bg-orange-50 text-brand-orange text-xs font-bold mb-3">
              {member.role}
            </span>
            <p class="text-slate-600 text-sm leading-relaxed">
              {member.bio}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Banner Ajakan CTA -->
    <div class="bg-gradient-to-r from-brand-orange via-amber-500 to-brand-orange rounded-3xl p-8 sm:p-12 text-white text-center shadow-soft-orange space-y-6">
      <h2 class="font-bubblegum text-3xl sm:text-4xl lg:text-5xl font-bold">
        Mari Bersama Berikan yang Terbaik untuk Buah Hati
      </h2>
      <p class="max-w-2xl mx-auto text-white/90 text-base sm:text-lg">
        Mulai perjalanan MPASI tanpa stres sekarang juga dengan menu siap saji bernutrisi seimbang.
      </p>
      <div>
        <a
          href="/#produk"
          class="inline-flex items-center gap-2 px-8 py-4 rounded-full font-bold text-brand-orange bg-white hover:bg-orange-50 transition shadow-xl text-lg hover:scale-105"
        >
          Piliih makanan sehat untuk si kecil
          <svg class="w-5 h-5 text-brand-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
          </svg>
        </a>
      </div>
    </div>

  </div>
</Layout>
