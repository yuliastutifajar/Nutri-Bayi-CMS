---
import Layout from '../../layouts/Layout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getPosts, getPostBlocks, type BlogPost } from '../../lib/notion';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

export interface Props {
  post: BlogPost;
}

const { post } = Astro.props;
const blocks = await getPostBlocks(post.id);

// Ambil artikel terkait (berdasarkan tag atau artikel lainnya)
const allPosts = await getPosts();
const relatedPosts = allPosts
  .filter((p) => p.slug !== post.slug)
  .slice(0, 3);

// Format Tanggal
function formatDateIndo(dateStr: string): string {
  try {
    const d = new Date(dateStr);
    return d.toLocaleDateString('id-ID', {
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  } catch {
    return dateStr;
  }
}

const formattedDate = formatDateIndo(post.date);

const siteUrl = import.meta.env.SITE_URL || Astro.site?.toString() || 'https://nutribayi.vercel.app';
const cleanSiteUrl = siteUrl.replace(/\/$/, '');
const articleUrl = `${cleanSiteUrl}/blog/${post.slug}`;

// Schema.org Article JSON-LD
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  headline: post.title,
  description: post.excerpt,
  image: [post.coverImage],
  datePublished: post.date,
  dateModified: post.date,
  author: {
    '@type': 'Person',
    name: post.author.name,
    jobTitle: post.author.role,
  },
  publisher: {
    '@type': 'Organization',
    name: 'NutriBayi',
    logo: {
      '@type': 'ImageObject',
      url: `${cleanSiteUrl}/favicon.svg`,
    },
  },
  keywords: post.tags.join(', '),
};

const breadcrumbItems = [
  { label: 'Beranda', href: '/' },
  { label: 'Blog', href: '/blog' },
  { label: post.title },
];

/**
 * Render Rich Text Notion ke HTML dengan format bold, italic, code, link
 */
function renderRichText(richTextArray: any[]): string {
  if (!richTextArray || !Array.isArray(richTextArray)) return '';

  return richTextArray
    .map((item) => {
      let text = item.plain_text || item.text?.content || '';
      // Escape HTML dasar
      text = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      const { bold, italic, strikethrough, underline, code } = item.annotations || {};

      if (code) text = `<code class="bg-orange-100 text-brand-orange px-1.5 py-0.5 rounded text-sm font-mono">${text}</code>`;
      if (bold) text = `<strong>${text}</strong>`;
      if (italic) text = `<em>${text}</em>`;
      if (strikethrough) text = `<del>${text}</del>`;
      if (underline) text = `<u>${text}</u>`;

      const linkUrl = item.href || item.text?.link?.url;
      if (linkUrl) {
        text = `<a href="${linkUrl}" target="_blank" rel="noopener noreferrer" class="text-brand-orange underline hover:text-brand-orange-600">${text}</a>`;
      }

      return text;
    })
    .join('');
}
---

<Layout
  title={post.title}
  description={post.excerpt}
  image={post.coverImage}
  type="article"
  publishDate={post.date}
  authorName={post.author.name}
  tags={post.tags}
  schemaData={articleSchema}
>
  <article class="pt-6 pb-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumbs Navigasi -->
      <Breadcrumbs items={breadcrumbItems} />

      <!-- Header Artikel -->
      <header class="mt-6 mb-10 space-y-6">
        
        <!-- Tags & Reading Time -->
        <div class="flex flex-wrap items-center gap-2">
          {post.tags.map((tag) => (
            <span class="badge-tag bg-brand-orange-50 text-brand-orange border border-brand-orange-200">
              {tag}
            </span>
          ))}
          <span class="text-xs text-slate-400 font-medium ml-auto flex items-center gap-1">
            <svg class="w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            {post.readingTime}
          </span>
        </div>

        <!-- Judul Artikel H1 -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-brand-blue leading-tight tracking-tight">
          {post.title}
        </h1>

        <!-- Excerpt / Ringkasan -->
        <p class="text-lg sm:text-xl text-slate-600 leading-relaxed font-normal italic border-l-4 border-brand-orange pl-4 bg-orange-50/40 py-2 rounded-r-2xl">
          {post.excerpt}
        </p>

        <!-- Info Penulis & Tanggal -->
        <div class="flex items-center justify-between border-y border-slate-100 py-4">
          <div class="flex items-center gap-3">
            <img
              src={post.author.avatar}
              alt={post.author.name}
              class="w-12 h-12 rounded-full object-cover border-2 border-brand-orange/40 shadow-sm"
              width="48"
              height="48"
            />
            <div>
              <span class="font-bold text-sm sm:text-base text-slate-800 block">
                {post.author.name}
              </span>
              <span class="text-xs text-slate-500 block">
                {post.author.role} • Dipublikasikan pada {formattedDate}
              </span>
            </div>
          </div>

          <!-- Tombol Share Cepat WhatsApp -->
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title} - Baca selengkapnya di: ${articleUrl}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-green-50 text-brand-green text-xs font-bold hover:bg-brand-green hover:text-white transition border border-brand-green-200"
            aria-label="Bagikan artikel ini ke WhatsApp"
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/>
            </svg>
            Share ke WhatsApp
          </a>
        </div>

      </header>

      <!-- Cover Image Utama -->
      <div class="mb-12 rounded-3xl overflow-hidden aspect-[16/9] shadow-xl bg-slate-100 border-4 border-orange-100/50">
        <img
          src={post.coverImage}
          alt={`Gambar utama panduan: ${post.title}`}
          loading="eager"
          decoding="async"
          class="w-full h-full object-cover"
          width="1200"
          height="675"
        />
      </div>

      <!-- KONTEN NOTION BLOCKS RENDERER -->
      <div class="notion-content text-slate-800 leading-relaxed max-w-none">
        {blocks.map((block) => {
          const type = block.type;

          // 1. Heading 1
          if (type === 'heading_1') {
            return <h2 class="text-3xl font-extrabold text-brand-blue mt-10 mb-4" set:html={renderRichText(block.heading_1.rich_text)} />;
          }

          // 2. Heading 2
          if (type === 'heading_2') {
            return <h2 class="text-2xl sm:text-3xl font-bold text-brand-blue mt-8 mb-4 pt-3 border-b border-slate-100 pb-2" set:html={renderRichText(block.heading_2.rich_text)} />;
          }

          // 3. Heading 3
          if (type === 'heading_3') {
            return <h3 class="text-xl sm:text-2xl font-bold text-brand-orange mt-6 mb-3" set:html={renderRichText(block.heading_3.rich_text)} />;
          }

          // 4. Paragraph
          if (type === 'paragraph') {
            const html = renderRichText(block.paragraph?.rich_text);
            return html ? <p class="mb-5 text-base sm:text-lg text-slate-700 leading-relaxed" set:html={html} /> : <div class="h-4" />;
          }

          // 5. Bulleted List Item
          if (type === 'bulleted_list_item') {
            return (
              <div class="flex items-start gap-3 my-2 pl-2">
                <span class="w-2.5 h-2.5 rounded-full bg-brand-orange mt-2.5 flex-shrink-0"></span>
                <span class="text-base sm:text-lg text-slate-700 leading-relaxed" set:html={renderRichText(block.bulleted_list_item.rich_text)} />
              </div>
            );
          }

          // 6. Numbered List Item
          if (type === 'numbered_list_item') {
            return (
              <div class="flex items-start gap-3 my-2 pl-2">
                <span class="font-bold text-brand-blue text-base sm:text-lg mt-0.5 flex-shrink-0">•</span>
                <span class="text-base sm:text-lg text-slate-700 leading-relaxed" set:html={renderRichText(block.numbered_list_item.rich_text)} />
              </div>
            );
          }

          // 7. Quote
          if (type === 'quote') {
            return (
              <blockquote class="border-l-4 border-brand-orange bg-brand-orange-50/70 p-5 rounded-r-2xl my-6 text-slate-800 italic shadow-sm" set:html={renderRichText(block.quote.rich_text)} />
            );
          }

          // 8. Callout Box
          if (type === 'callout') {
            const emoji = block.callout?.icon?.emoji || '💡';
            return (
              <div class="flex items-start gap-4 p-5 rounded-2xl bg-brand-blue-50 border border-brand-blue-200 my-6 shadow-sm">
                <span class="text-2xl flex-shrink-0">{emoji}</span>
                <div class="text-slate-800 text-sm sm:text-base leading-relaxed font-medium" set:html={renderRichText(block.callout.rich_text)} />
              </div>
            );
          }

          // 9. Image Block dari Notion
          if (type === 'image') {
            const imgUrl = block.image?.file?.url || block.image?.external?.url;
            const caption = block.image?.caption ? renderRichText(block.image.caption) : post.title;
            return (
              <figure class="my-8">
                <img
                  src={imgUrl}
                  alt={caption || `Ilustrasi ${post.title}`}
                  loading="lazy"
                  decoding="async"
                  class="rounded-3xl w-full shadow-md object-cover max-h-[500px]"
                />
                {caption && (
                  <figcaption class="text-center text-xs text-slate-500 mt-2 italic" set:html={caption} />
                )}
              </figure>
            );
          }

          // 10. Divider
          if (type === 'divider') {
            return <hr class="my-8 border-slate-200" />;
          }

          return null;
        })}
      </div>

      <!-- Social Share Buttons -->
      <div class="mt-14 pt-8 border-t border-slate-200">
        <h3 class="font-bubblegum text-xl font-bold text-brand-blue mb-4">
          Bermanfaat untuk Bunda Lain? Bagikan Artikel Ini:
        </h3>
        <div class="flex flex-wrap items-center gap-3">
          <!-- WhatsApp -->
          <a
            href={`https://api.whatsapp.com/send?text=${encodeURIComponent(`${post.title}\n${articleUrl}`)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#25D366] text-white font-bold text-xs sm:text-sm hover:opacity-90 transition shadow-sm"
          >
            WhatsApp
          </a>

          <!-- Facebook -->
          <a
            href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-[#1877F2] text-white font-bold text-xs sm:text-sm hover:opacity-90 transition shadow-sm"
          >
            Facebook
          </a>

          <!-- Twitter / X -->
          <a
            href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(post.title)}&url=${encodeURIComponent(articleUrl)}`}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-900 text-white font-bold text-xs sm:text-sm hover:opacity-90 transition shadow-sm"
          >
            Twitter
          </a>

          <!-- Copy Link Button -->
          <button
            id="copy-link-btn"
            type="button"
            class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs sm:text-sm transition"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"/>
            </svg>
            <span id="copy-text">Salin Tautan</span>
          </button>
        </div>
      </div>

      <!-- CTA Box Rekomendasi Makanan Sehat -->
      <div class="mt-14 bg-gradient-to-r from-brand-orange-50 via-orange-100/60 to-brand-orange-50 rounded-3xl p-8 border-2 border-brand-orange/30 shadow-md flex flex-col md:flex-row items-center justify-between gap-6">
        <div class="space-y-2 text-center md:text-left">
          <span class="inline-block px-3 py-1 rounded-full bg-brand-orange text-white text-xs font-bold uppercase tracking-wider">
            Rekomendasi Spesial
          </span>
          <h3 class="font-bubblegum text-2xl sm:text-3xl font-bold text-brand-blue">
            Ingin Menu Praktis Seperti dalam Resep Ini?
          </h3>
          <p class="text-slate-700 text-sm sm:text-base max-w-lg">
            Pesan paket MPASI siap saji NutriBayi dengan bahan organik, takaran zat besi tepat, dan rasa alami yang disukai bayi.
          </p>
        </div>
        <div>
          <a
            href="/#produk"
            class="btn-primary text-base py-3.5 px-7 shadow-soft-orange whitespace-nowrap"
          >
            Piliih makanan sehat untuk si kecil
          </a>
        </div>
      </div>

      <!-- ARTIKEL TERKAIT -->
      {relatedPosts.length > 0 && (
        <div class="mt-20 pt-10 border-t border-slate-200">
          <div class="flex items-center justify-between mb-8">
            <h2 class="font-bubblegum text-2xl sm:text-3xl font-bold text-brand-blue">
              Panduan Terkait Lainnya
            </h2>
            <a href="/blog" class="text-sm font-bold text-brand-orange hover:underline">
              Lihat Semua →
            </a>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((rel) => (
              <BlogCard post={rel} />
            ))}
          </div>
        </div>
      )}

    </div>
  </article>
</Layout>

<script>
  const copyBtn = document.getElementById('copy-link-btn');
  const copyText = document.getElementById('copy-text');

  if (copyBtn && copyText) {
    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        copyText.textContent = 'Tersalin! ✓';
        setTimeout(() => {
          copyText.textContent = 'Salin Tautan';
        }, 2000);
      } catch (err) {
        console.error('Gagal menyalin tautan:', err);
      }
    });
  }
</script>
