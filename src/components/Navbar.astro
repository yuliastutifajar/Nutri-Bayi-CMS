---
const currentPath = Astro.url.pathname;

const navLinks = [
  { name: 'Beranda', href: '/' },
  { name: 'Produk MPASI', href: '/#produk' },
  { name: 'Panduan & Resep', href: '/blog' },
  { name: 'Tentang Kami', href: '/about' },
];
---

<header class="sticky top-0 z-50 bg-white/90 backdrop-blur-md border-b border-orange-100 transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Logo Brand -->
      <a href="/" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-brand-blue rounded-2xl p-1">
        <div class="w-12 h-12 rounded-2xl bg-brand-orange-50 border-2 border-brand-orange flex items-center justify-center shadow-soft-orange group-hover:scale-105 transition-transform">
          <svg class="w-7 h-7 text-brand-orange" viewBox="0 0 64 64" fill="none" xmlns="http://www.w3.org/2000/svg">
            <circle cx="32" cy="32" r="28" fill="#fff7ed"/>
            <path d="M16 32C16 41.94 23.16 50 32 50C40.84 50 48 41.94 48 32H16Z" fill="#f76806"/>
            <path d="M20 32C20 28 25 26 32 26C39 26 44 28 44 32H20Z" fill="#0b6623"/>
            <path d="M42 16L32 29" stroke="#0041c2" stroke-width="4" stroke-linecap="round"/>
            <ellipse cx="45" cy="14" rx="5" ry="3" transform="rotate(-30 45 14)" fill="#0041c2"/>
          </svg>
        </div>
        <div>
          <span class="font-bubblegum text-2xl md:text-3xl font-extrabold text-brand-blue tracking-wide block leading-none">
            Nutri<span class="text-brand-orange">Bayi</span>
          </span>
          <span class="text-[11px] font-semibold text-brand-green tracking-wider uppercase block mt-1">
            Media & MPASI Sehat
          </span>
        </div>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="hidden md:flex items-center gap-1 lg:gap-2">
        {navLinks.map((link) => {
          const isActive = currentPath === link.href || (link.href !== '/' && currentPath.startsWith(link.href));
          return (
            <a
              href={link.href}
              class={`px-4 py-2 rounded-full text-sm font-semibold transition-all duration-200 ${
                isActive
                  ? 'text-brand-blue bg-brand-blue-50 font-bold shadow-sm'
                  : 'text-slate-600 hover:text-brand-orange hover:bg-orange-50/60'
              }`}
            >
              {link.name}
            </a>
          );
        })}
      </nav>

      <!-- Desktop CTA Button -->
      <div class="hidden md:flex items-center gap-3">
        <a
          href="/#produk"
          class="btn-primary text-sm py-2.5 px-5 shadow-soft-orange"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/>
          </svg>
          Pilih Makanan Sehat
        </a>
      </div>

      <!-- Mobile Hamburger Button -->
      <div class="flex md:hidden">
        <button
          id="mobile-menu-btn"
          type="button"
          aria-label="Buka Menu Navigasi"
          class="p-2.5 rounded-2xl text-slate-700 hover:text-brand-orange hover:bg-orange-50 focus:outline-none focus:ring-2 focus:ring-brand-orange transition"
        >
          <svg id="menu-icon-open" class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
          </svg>
          <svg id="menu-icon-close" class="w-7 h-7 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-white border-b border-orange-100 px-4 pt-3 pb-6 space-y-3 shadow-xl">
    <div class="flex flex-col space-y-2">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class="px-4 py-3 rounded-2xl text-base font-semibold text-slate-700 hover:text-brand-orange hover:bg-orange-50 transition"
        >
          {link.name}
        </a>
      ))}
    </div>
    <div class="pt-2">
      <a
        href="/#produk"
        class="btn-primary w-full text-center py-3 justify-center shadow-soft-orange"
      >
        Pilih Makanan Sehat
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  if (btn && menu && iconOpen && iconClose) {
    btn.addEventListener('click', () => {
      const isHidden = menu.classList.contains('hidden');
      if (isHidden) {
        menu.classList.remove('hidden');
        iconOpen.classList.add('hidden');
        iconClose.classList.remove('hidden');
      } else {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      }
    });

    // Tutup menu saat link diklik
    const links = menu.querySelectorAll('a');
    links.forEach(l => {
      l.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen.classList.remove('hidden');
        iconClose.classList.add('hidden');
      });
    });
  }
</script>
