---
// Hero section untuk NutriBayi (Digital Media & Produk MPASI Sehat)
---

<section class="relative overflow-hidden pt-8 pb-16 md:pt-16 md:pb-24 bg-gradient-to-b from-orange-50/50 via-white to-white">
  <!-- Elemen Dekoratif Background Lingkaran Lembut -->
  <div class="absolute top-10 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-tr from-brand-orange-100/40 via-blue-100/30 to-green-100/30 rounded-full blur-3xl -z-10 pointer-events-none"></div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
      
      <!-- Kolom Teks & Value Proposition -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Badge Kategori Terpercaya -->
        <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-brand-orange-50 border border-brand-orange-200 text-brand-orange text-xs md:text-sm font-bold shadow-sm">
          <span class="flex h-2.5 w-2.5 rounded-full bg-brand-orange animate-ping"></span>
          <span>Sahabat Terpercaya Ibu Muda & Bayi 6–24 Bulan</span>
        </div>

        <!-- Headline Utama dengan Font Bubblegum Sans & Brand Blue -->
        <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-brand-blue leading-[1.15] tracking-tight">
          MPASI Sehat, Praktis & Bergizi untuk <span class="text-brand-orange underline decoration-wavy decoration-orange-300">Tumbuh Kembang</span> Si Kecil
        </h1>

        <!-- Deskripsi Produk & Media -->
        <p class="text-base sm:text-lg md:text-xl text-slate-600 max-w-2xl mx-auto lg:mx-0 leading-relaxed font-normal">
          Bantu penuhi nutrisi harian bayi dengan menu MPASI alami tanpa pengawet. Praktis disiapkan, teruji aman, dan diformulasikan oleh ahli gizi untuk dukung si kecil lahap makan tanpa drama GTM.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-2">
          <a
            href="#produk"
            class="btn-primary w-full sm:w-auto text-center text-lg py-4 px-8 shadow-soft-orange group"
          >
            <span>Pilih makanan sehat untuk si kecil</span>
            <svg class="w-5 h-5 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
            </svg>
          </a>

          <a
            href="/blog"
            class="btn-secondary w-full sm:w-auto text-center text-lg py-4 px-7"
          >
            <svg class="w-5 h-5 text-brand-blue" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/>
            </svg>
            Baca Panduan & Resep
          </a>
        </div>

        <!-- Trust Badges List -->
        <div class="pt-6 border-t border-slate-100 grid grid-cols-3 gap-4 max-w-lg mx-auto lg:mx-0">
          <div class="flex flex-col items-center lg:items-start">
            <span class="font-bubblegum text-2xl md:text-3xl text-brand-orange font-bold">100%</span>
            <span class="text-xs text-slate-500 font-medium text-center lg:text-left">Bahan Alami & Halal</span>
          </div>
          <div class="flex flex-col items-center lg:items-start">
            <span class="font-bubblegum text-2xl md:text-3xl text-brand-blue font-bold">5 Menit</span>
            <span class="text-xs text-slate-500 font-medium text-center lg:text-left">Praktis Siap Saji</span>
          </div>
          <div class="flex flex-col items-center lg:items-start">
            <span class="font-bubblegum text-2xl md:text-3xl text-brand-green font-bold">25.000+</span>
            <span class="text-xs text-slate-500 font-medium text-center lg:text-left">Ibu Muda Percaya</span>
          </div>
        </div>

      </div>

      <!-- Kolom Visual Interaktif / Card Showcase -->
      <div class="lg:col-span-5 relative">
        <div class="relative mx-auto max-w-md lg:max-w-none">
          
          <!-- Card Utama Hero -->
          <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-2xl border-4 border-orange-100 relative z-10 transition-transform duration-300 hover:scale-[1.01]">
            
            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] mb-6 bg-orange-50">
              <img
                src="https://images.unsplash.com/photo-1596461404969-9ae70f2830c1?auto=format&fit=crop&w=800&q=80"
                alt="Bayi sehat makan MPASI bernutrisi tinggi"
                class="w-full h-full object-cover"
                loading="eager"
                width="800"
                height="600"
              />
              <div class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm px-3 py-1.5 rounded-full text-xs font-bold text-brand-green flex items-center gap-1.5 shadow-sm">
                <span class="w-2 h-2 rounded-full bg-brand-green"></span>
                Kaya Zat Besi & Omega-3
              </div>
            </div>

            <!-- Detail Nilai Gizi Ringkas -->
            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <div>
                  <h3 class="font-bubblegum text-xl text-brand-blue font-bold">Paket MPASI Fresh Gold</h3>
                  <p class="text-xs text-slate-500">Menu 4 Bintang: Daging Sapi, Hati Ayam, Salmon & Sayur Organik</p>
                </div>
                <div class="text-right">
                  <span class="text-xs text-slate-400 line-through">Rp 85.000</span>
                  <div class="text-xl font-bold text-brand-orange">Rp 65.000</div>
                </div>
              </div>

              <!-- Rating & Review -->
              <div class="flex items-center justify-between pt-3 border-t border-slate-100 text-xs">
                <div class="flex items-center gap-1 text-amber-500">
                  <span>⭐⭐⭐⭐⭐</span>
                  <span class="font-bold text-slate-700 ml-1">4.9/5</span>
                </div>
                <span class="text-slate-500">Dari 1.250+ ulasan ibu</span>
              </div>
            </div>

          </div>

          <!-- Floating Badge 1: Anti-GTM -->
          <div class="absolute -bottom-6 -left-4 sm:-left-8 bg-white rounded-2xl p-4 shadow-xl border border-orange-100 flex items-center gap-3 z-20 animate-float">
            <div class="w-12 h-12 rounded-xl bg-brand-green-50 text-brand-green flex items-center justify-center font-bold text-2xl">
              🥑
            </div>
            <div>
              <div class="text-xs text-slate-500 font-medium">Solusi Efektif</div>
              <div class="text-sm font-bold text-brand-green">Atasi Anak GTM!</div>
            </div>
          </div>

          <!-- Floating Badge 2: Bebas Pengawet -->
          <div class="absolute -top-4 -right-4 sm:-right-6 bg-brand-blue text-white rounded-2xl p-3.5 shadow-xl flex items-center gap-2.5 z-20">
            <svg class="w-5 h-5 text-amber-300" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
            </svg>
            <div class="text-xs font-bold leading-tight">
              0% Gula, Garam &<br/>Pengawet Buatan
            </div>
          </div>

        </div>
      </div>

    </div>
  </div>
</section>
