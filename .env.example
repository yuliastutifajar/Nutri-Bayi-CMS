# ==========================================
# KONFIGURASI NOTION API & WEBSITE NUTRIBAYI
# ==========================================

# Token Integrasi Internal Notion (dimulai dengan "ntn_..." atau "secret_...")
# Dapatkan dari: https://www.notion.so/my-integrations
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database ID dari Notion Database MPASI Anda (32 karakter alfanumerik)
# Contoh dari URL database: https://www.notion.so/workspace/1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p?v=...
# Database ID adalah: 1a2b3c4d5e6f7g8h9i0j1k2l3m4n5o6p
NOTION_DATABASE_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# URL Publik Website (digunakan untuk SEO, Sitemap, dan Canonical URL)
SITE_URL=https://nutribayi.vercel.app
